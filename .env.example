# Server Configuration
PORT=3000
NODE_ENV=development
SITE_URL=https://yourdomain.com

# Cybersecurity & Admin Protection
# Secret key required to view customer order records at /api/orders
ADMIN_SECRET_KEY=change_this_to_a_super_secret_key_12345

# Razorpay API Credentials (Get these from https://dashboard.razorpay.com/#/access_keys)
# For testing, use Test Keys: rzp_test_xxxxxxxxxxxx
# For production, use Live Keys: rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Analytics & Web Tracking
# Google Analytics 4 (GA4) Measurement ID (e.g. G-ABC123XYZ)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Meta Pixel (Facebook Pixel) ID (e.g. 123456789012345)
META_PIXEL_ID=123456789012345

# Product Configuration
PRODUCT_NAME=AI की मदद से अपना पहला डिजिटल बिज़नेस (eBook + Bonuses)
PRODUCT_PRICE=199
PRODUCT_CURRENCY=INR
PRODUCT_MRP=999

# Order Bump (Optional - e.g. AI Prompt Vault / Masterclass)
ORDER_BUMP_ENABLED=true
ORDER_BUMP_TITLE=🔥 Exclusive AI Prompt Vault (500+ Master Prompts)
ORDER_BUMP_PRICE=99

# Support & Contact
SUPPORT_EMAIL=support@mydigitalstore.com
SUPPORT_WHATSAPP=+919876543210
STORE_NAME=DigitalGuru AI
